{
  "name": "Intent RAG Generator (Fixed)",
  "nodes": [
    {
      "id": "trigger_1",
      "name": "Scheduled Trigger",
      "type": "n8n-nodes-base.scheduleTrigger",
      "typeVersion": 1.3,
      "position": [
        0,
        300
      ],
      "parameters": {
        "rule": {
          "interval": [
            {
              "field": "minutes"
            }
          ]
        }
      }
    },
    {
      "id": "fetch_intents",
      "name": "Fetch Intents Relation",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.4,
      "position": [
        220,
        300
      ],
      "parameters": {
        "url": "http://192.168.1.100:5678/webhook/relation-targets?id=start-node",
        "options": {}
      }
    },
    {
      "id": "split_items",
      "name": "Split Items",
      "type": "n8n-nodes-base.splitInBatches",
      "typeVersion": 3,
      "position": [
        440,
        300
      ],
      "parameters": {
        "batchSize": 1
      }
    },
    {
      "id": "build_rag",
      "name": "Build RAG Content",
      "type": "n8n-nodes-base.function",
      "typeVersion": 1,
      "position": [
        680,
        300
      ],
      "parameters": {
        "functionCode": "const p = $input.first().json;\n\nconst intent = p.label || 'unknown_intent';\nconst type = p.type || 'unknown_type';\n\nconst rag = [\n  `INTENT: ${intent}`,\n  `TYPE: ${type}`,\n  `ACTION_ID: ${p.action_id}`,\n  `NAME: ${p.name || ''}`,\n  `LABEL: ${p.label || ''}`,\n  `DESCRIPTION: ${p.description || ''}`,\n  `TABLE: ${p.config?.table || ''}`,\n  `OPERATION: ${p.config?.operation || ''}`,\n  `PARAMETERS: ${(p.parameters || []).map(x => x.name).join(', ')}`,\n  `KEYWORDS: ${(p.label + ' ' + p.name + ' ' + (p.description || '')).toLowerCase()}`,\n  `CONTEXT: intent_rag_system`\n].join(' | ');\n\nreturn [{\n  json: {\n    ...p,\n    content: rag\n  }\n}];"
      }
    },
    {
      "id": "embed",
      "name": "Generate Embedding",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.4,
      "position": [
        920,
        300
      ],
      "parameters": {
        "url": "http://192.168.1.120:11434/api/embed",
        "method": "POST",
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={\n  \"model\": \"nomic-embed-text\",\n  \"input\": \"{{ $json.content }}\"\n}"
      }
    },
    {
      "id": "prepare_db",
      "name": "Prepare DB Payload",
      "type": "n8n-nodes-base.function",
      "typeVersion": 1,
      "position": [
        1160,
        300
      ],
      "parameters": {
        "functionCode": "const p = $input.first().json;\n\nconst embedding = $node[\"Generate Embedding\"].json.embedding;\n\nreturn [{\n  json: {\n    table: \"ai_memory\",\n    operation: \"upsertAiRag\",\n    data: {\n      id: p.action_id,\n      scope: \"intent\",\n      scope_id: p.relation_id,\n      content: p.content,\n      embedding: embedding,\n      metadata: {\n        intent: p.label,\n        type: p.type\n      }\n    }\n  }\n}];"
      }
    },
    {
      "id": "save",
      "name": "Save AI Memory",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.4,
      "position": [
        1400,
        300
      ],
      "parameters": {
        "url": "http://192.168.1.100:9010/ai/rag",
        "method": "POST",
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={{ $json }}"
      }
    },
    {
      "id": "loop_back",
      "name": "Loop Back",
      "type": "n8n-nodes-base.noOp",
      "typeVersion": 1,
      "position": [
        1600,
        300
      ]
    }
  ],
  "connections": {
    "Scheduled Trigger": {
      "main": [
        [
          {
            "node": "Fetch Intents Relation",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Fetch Intents Relation": {
      "main": [
        [
          {
            "node": "Split Items",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Split Items": {
      "main": [
        [],
        [
          {
            "node": "Build RAG Content",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Build RAG Content": {
      "main": [
        [
          {
            "node": "Generate Embedding",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Generate Embedding": {
      "main": [
        [
          {
            "node": "Prepare DB Payload",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Prepare DB Payload": {
      "main": [
        [
          {
            "node": "Save AI Memory",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Save AI Memory": {
      "main": [
        [
          {
            "node": "Split Items",
            "type": "main",
            "index": 1
          }
        ]
      ]
    }
  },
  "active": false,
  "settings": {
    "executionOrder": "v1"
  }
}
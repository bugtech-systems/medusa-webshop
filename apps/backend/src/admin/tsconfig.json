{
  "extends": "../../tsconfig.json",
  "compilerOptions": {
    "module": "Node16",
    "moduleResolution": "Node16",
    "target": "ES2021",
    "esModuleInterop": true,
    // Add these for Monaco compatibility:
    "allowSyntheticDefaultImports": true,
    "isolatedModules": true,
    "lib": ["dom", "dom.iterable", "esnext"],
    "noEmit": true,
    "jsx": "react-jsx",
  },
  "include": [".","src/**/*"],
  "exclude": ["**/*.spec.js"]
}
